# Copy to .env and fill in. Only the Groq key is required to run with the
# in-memory tools; everything below it switches on the production
# Google-backed implementations at the composition root (see
# src/prime_estate/api.py).

# --- Required: Groq (LLM) --------------------------------------------------
# Get a key at https://console.groq.com/keys
PRIME_GROQ_API_KEY=gsk_your_key_here
PRIME_GROQ_MODEL=llama-3.3-70b-versatile

# --- Session policy --------------------------------------------------------
PRIME_SESSION_TTL_SECONDS=1800
PRIME_LOG_LEVEL=INFO
PRIME_TIMEZONE=Asia/Karachi

# --- Google (Sheets datastore + Calendar bookings) -------------------------
# Path to a service-account JSON key file. Create one in Google Cloud Console
# (APIs & Services -> Credentials -> Service account -> Keys), enable the
# Sheets and Calendar APIs on the project, then SHARE the sheet and the
# calendar with the service account's client_email. When this is set together
# with the ids below, the Google tools replace the in-memory ones.
PRIME_GOOGLE_SERVICE_ACCOUNT_FILE=
# The long id from the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
PRIME_SHEET_ID=
# From Google Calendar -> Settings -> "Integrate calendar" -> Calendar ID
PRIME_CALENDAR_ID=

# --- Gmail (booking confirmation emails) -----------------------------------
# App password, NOT the account password: Google Account -> Security ->
# 2-Step Verification -> App passwords. Leave empty to disable email.
PRIME_GMAIL_USER=
PRIME_GMAIL_APP_PASSWORD=
