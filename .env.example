# Copy to .env and fill in. Only the Groq key is required to run with the
# in-memory tools; calendar/sheet ids are for the production Google-backed
# implementations.
PRIME_GROQ_API_KEY=gsk_your_key_here
PRIME_GROQ_MODEL=llama-3.3-70b-versatile
PRIME_SESSION_TTL_SECONDS=1800
PRIME_CALENDAR_ID=
PRIME_SHEET_ID=
PRIME_LOG_LEVEL=INFO
